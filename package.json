{
  "name": "sistema-pos-backend",
  "version": "1.5.0",
  "private": true,
  "description": "API del Sistema POS (restaurante -> retail). Node/TS + NestJS + MongoDB.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "seed": "tsc -p tsconfig.build.json && node dist/seed.js",
    "seed:demo": "tsc -p tsconfig.build.json && node dist/seed-demo.js",
    "seed:payroll": "tsc -p tsconfig.build.json && node dist/seed-payroll.js",
    "eval:facturas": "tsc -p tsconfig.build.json && node dist/eval-invoices.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "gates": "node scripts/gates.mjs",
    "secretos": "node scripts/check-no-secrets.mjs",
    "sonda": "node scripts/sonda-prod.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/throttler": "^6.7.1",
    "@sentry/node": "^11.7.0",
    "@supabase/supabase-js": "^2.114.0",
    "@vercel/functions": "3.9.11",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "fast-xml-parser": "5.11.2",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.17.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@swc/core": "^1.16.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^9.39.5",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-swc": "^1.5.11",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
