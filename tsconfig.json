{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    // DOM se incluye por los tipos de la API fetch (Response, RequestInit), que
    // el código usa como globales en billing/wompi.client.ts. Node 20 trae fetch
    // en runtime, pero sus tipos llegan por `undici-types` vía @types/node y esa
    // resolución no es fiable en todos los entornos de instalación (falla en el
    // build de Vercel). DOM los declara siempre. `skipLibCheck` evita el choque
    // de declaraciones duplicadas entre ambas libs.
    "lib": ["ES2021", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": "src",
    "paths": {
      "@modules/*": ["modules/*"],
      "@shared/*": ["shared/*"],
      "@config/*": ["config/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
