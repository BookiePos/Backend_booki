# ─── Base de datos ───────────────────────────────────────────────────────────
# Datos operativos. La base de control (empresas/suscripciones) se deriva
# cambiando el nombre a gocheck_control, o se fija con CONTROL_MONGODB_URI.
MONGODB_URI=mongodb://localhost:27017/ert
# CONTROL_MONGODB_URI=mongodb://localhost:27017/gocheck_control

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Autenticación (JWT) ─────────────────────────────────────────────────────
# Obligatorias en producción. Genera secretos largos y aleatorios.
JWT_SECRET=cambia-esto
JWT_REFRESH_SECRET=cambia-esto-tambien
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=

# ─── Correo (invitaciones, colillas) ─────────────────────────────────────────
# RESEND_API_KEY=
# MAIL_FROM=GoCheck <no-reply@tu-dominio.com>
# APP_URL=http://localhost:3000
# INVITE_EXPIRES_DAYS=7

# ─── Pasarela de pagos: Wompi (Colombia) ─────────────────────────────────────
# Por defecto SANDBOX. Toma las llaves del panel de Wompi (sección Desarrolladores).
#   - Public/Private key: pub_test_... / prv_test_... (sandbox)
#   - Integrity secret: para firmar transacciones
#   - Events secret: para validar el checksum del webhook
# Configura el webhook de Wompi apuntando a:  {APP_URL_BACKEND}/billing/webhook
WOMPI_ENV=sandbox
# WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ─── Seeders (opcionales) ────────────────────────────────────────────────────
# SEED_DEMO_EMAIL=demo@sistemapos.local
# SEED_DEMO_PASSWORD=Demo123!
# SEED_FORCE=false
