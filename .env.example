# --- Base de datos ---
# Mongo debe correr como replica set para soportar transacciones multi-documento.
MONGODB_URI=mongodb://localhost:27017/erp?replicaSet=rs0
DB_NAME=erp

# --- App ---
NODE_ENV=development
PORT=3001

# --- Auth ---
JWT_SECRET=cambia-esto
JWT_EXPIRES_IN=8h

# --- Multi-sede (sede por defecto al arrancar) ---
DEFAULT_SEDE=centro

# --- Zona horaria (Colombia) ---
TZ=America/Bogota
