# ─── Variables del backend (API BookiPos) ────────────────────────────────────
#
# Los valores de abajo son los de DESARROLLO. Al final de cada bloque va el
# valor de PRODUCCIÓN para el despliegue en api.bookipos.com.
#
# Copia este archivo a `.env`. Nunca lo commitees: `.env` está en .gitignore.

# ─── Base de datos ───────────────────────────────────────────────────────────
# Datos operativos. La base de control (empresas/suscripciones) se deriva
# cambiando el nombre a bookipos_control, o se fija con CONTROL_MONGODB_URI.
#
# ⚠️  El replica set NO es opcional: el sistema usa transacciones de MongoDB
#     para ventas, caja y asientos contables. Contra un mongod suelto esas
#     operaciones fallan en tiempo de ejecución, no al arrancar.
#     Producción: usa Atlas (ya viene en replica set) o un rs propio.
MONGODB_URI=mongodb://localhost:27017/sistema-pos?replicaSet=rs0
# CONTROL_MONGODB_URI=mongodb://localhost:27017/bookipos_control

# ─── Servidor ────────────────────────────────────────────────────────────────
# NODE_ENV=production activa dos cosas que en dev están apagadas: la cookie
# de refresh pasa a Secure, y los orígenes localhost/http se filtran del CORS.
# Si lo dejas en development detrás de HTTPS, la sesión no persiste.
PORT=3001
NODE_ENV=development

# Orígenes del navegador autorizados, separados por coma. Es el ORIGEN del
# frontend, nunca el del API.
#
# Producción:  CORS_ORIGIN=https://www.bookipos.com,https://bookipos.com
#   Incluye el apex además del www solo si el apex sirve la app en vez de
#   redirigir. Para el navegador `bookipos.com` y `www.bookipos.com` son
#   orígenes DISTINTOS; si el apex redirige 301 al www, sobra listarlo.
CORS_ORIGIN=http://localhost:3000

# ─── Autenticación (JWT) ─────────────────────────────────────────────────────
# Obligatorias en producción. Genera secretos largos y aleatorios, distintos
# entre sí:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto
JWT_REFRESH_SECRET=cambia-esto-tambien
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# SameSite de la cookie de refresh. `lax` es CORRECTO en producción y no hay
# que cambiarlo: www.bookipos.com y api.bookipos.com comparten el dominio
# registrable (bookipos.com), así que el navegador los considera "same-site" y
# manda la cookie sin problema. `none` solo haría falta si el front viviera en
# otro dominio, y debilita la protección CSRF a cambio de nada.
# AUTH_COOKIE_SAMESITE=lax

# Dominio de la cookie. DÉJALO VACÍO también en producción.
# Vacío = cookie host-only de api.bookipos.com, que es exactamente a donde se
# envía (la cookie está acotada a la ruta /auth del API). Ponerle
# `.bookipos.com` la difundiría además a www y a cualquier subdominio futuro
# sin ganar nada. Menos alcance, menos superficie.
# AUTH_COOKIE_DOMAIN=

# ─── Correo (invitaciones, colillas) ─────────────────────────────────────────
# APP_URL es la base de los enlaces que salen por correo (aceptar invitación).
# Apunta al FRONT, no al API, o los invitados aterrizan en un JSON.
#   Producción: APP_URL=https://www.bookipos.com
#
# MAIL_FROM tiene que usar un dominio verificado en Resend, con sus registros
# SPF/DKIM publicados. Con `onboarding@resend.dev` los correos salen, pero solo
# llegan a tu propia dirección: en producción los clientes no reciben nada.
#   Producción: MAIL_FROM=BookiPos <no-reply@bookipos.com>
# RESEND_API_KEY=
# MAIL_FROM=BookiPos <no-reply@tu-dominio.com>
# APP_URL=http://localhost:3000
# INVITE_EXPIRES_DAYS=7

# ─── Pasarela de pagos: Wompi (Colombia) ─────────────────────────────────────
# Por defecto SANDBOX. Toma las llaves del panel de Wompi (sección Desarrolladores).
#   - Public/Private key: pub_test_... / prv_test_... (sandbox)
#                         pub_prod_... / prv_prod_... (producción)
#   - Integrity secret: para firmar transacciones
#   - Events secret: para validar el checksum del webhook
#
# Webhook a registrar en el panel de Wompi:
#   Desarrollo:  http://localhost:3001/billing/webhook
#   Producción:  https://api.bookipos.com/billing/webhook
#
# WOMPI_BASE_URL se deduce de WOMPI_ENV; solo se fija a mano para pruebas.
WOMPI_ENV=sandbox
# WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ─── Seeders (opcionales) ────────────────────────────────────────────────────
# Solo para poblar entornos de prueba. NO los definas en producción: SEED_FORCE
# reescribe datos existentes.
#
# Cuenta dueña que crea `pnpm seed`. Sin SEED_ADMIN_PASSWORD el seed usa una
# contraseña de ejemplo, así que en producción es OBLIGATORIA: el seed se niega
# a correr sin ella en vez de dejar abierta una cuenta con clave conocida.
# SEED_ADMIN_EMAIL=admin@sistemapos.local
# SEED_ADMIN_PASSWORD=
#
# Código de la sede que se crea con la empresa semilla.
# DEFAULT_SEDE=centro
#
# Períodos que genera el seed de nómina (`pnpm seed:payroll`), separados por
# coma y en formato AAAA-MM. Por defecto, los últimos tres meses.
# SEED_PAYROLL_PERIODS=2026-06,2026-07,2026-08
#
# SEED_DEMO_EMAIL=demo@sistemapos.local
# SEED_DEMO_PASSWORD=Demo123!
# SEED_FORCE=false
