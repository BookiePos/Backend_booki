# --- Base de datos ---
# Mongo debe correr como replica set para soportar transacciones multi-documento.
MONGODB_URI=mongodb://localhost:27017/sistema-pos?replicaSet=rs0
DB_NAME=sistema-pos

# --- App ---
NODE_ENV=development
PORT=3001

# --- Auth (JWT access + refresh) ---
JWT_SECRET=cambia-esto
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=cambia-esto-refresh
JWT_REFRESH_EXPIRES=7d

# --- Semilla (usuario admin inicial creado por `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@sistemapos.local
SEED_ADMIN_PASSWORD=Admin123!

# --- Multi-sede (sede por defecto al arrancar) ---
DEFAULT_SEDE=centro

# --- Zona horaria (Colombia) ---
TZ=America/Bogota

# --- Email (Resend) ---
# Crea una API key en https://resend.com/api-keys y pégala aquí.
# En modo de pruebas (from=onboarding@resend.dev) Resend SOLO entrega al email
# dueño de tu cuenta Resend. Para enviar a cualquiera, verifica un dominio y
# cambia MAIL_FROM a algo como no-reply@tudominio.com.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
APP_URL=http://localhost:3000
INVITE_EXPIRES_DAYS=7
